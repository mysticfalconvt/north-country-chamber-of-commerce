# Database connection string
DATABASE_URL=postgres://postgres:password@10.0.0.50:3998/chamber_of_commerce

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Translation API (self-hosted LLM with OpenAI-compatible API)
TRANSLATION_API_URL=http://10.0.0.156:1234/v1
TRANSLATION_MODEL=openai/gpt-oss-120b
TRANSLATION_API_KEY=not-needed

# Email (SMTP settings for Nodemailer)
# For development, you can use a service like Ethereal (https://ethereal.email/)
# or MailHog (local SMTP server)
# For production, use your actual SMTP provider (Gmail, SendGrid, etc.)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vtnorthcountry.org

# Admin notification email (receives business/event approval requests)
# Can be a single email or comma-separated list
ADMIN_NOTIFICATION_EMAIL=admin@vtnorthcountry.org

# Error tracking (Bugsink -- Sentry SDK compatible, self-hosted)
# Leave the DSN unset to disable error reporting entirely.
NEXT_PUBLIC_BUGSINK_DSN=https://6b97b76d9d824ade9445263ca7d9ad82@bugsink.rboskind.com/6
# Optional: label issues by environment (defaults to NODE_ENV)
#NEXT_PUBLIC_BUGSINK_ENVIRONMENT=production
# Sourcemap upload at build time. Without a token, maps are neither generated nor
# uploaded and stack traces in Bugsink stay minified.
# Create one in Bugsink under your user settings -> auth tokens.
BUGSINK_AUTH_TOKEN=
BUGSINK_URL=https://bugsink.rboskind.com/
BUGSINK_PROJECT=north-country-chamber-of-commerce

# Seed endpoint configuration (SECURITY CRITICAL)
# Set to 'true' to enable the /api/seed endpoint
# WARNING: Should be 'false' or unset in production
ENABLE_SEED_ENDPOINT=false
# Secret token required to call the seed endpoint (use a long random string)
# Generate with: openssl rand -base64 32
SEED_API_TOKEN=your-random-secret-token-here
